# --- Decision model: Laya, running in this process. No account or API key. ---
# Default: browser fine-tune (third-party, Apache-2.0, trained on this agent's request format), pinned to a commit.
LAYA_MODEL=cklxx/laya-browser
# Generic Laya is not trained on browser tasks; it answered DONE/BLOCKED on every recorded page. Test before using.
# LAYA_MODEL=convaiinnovations/laya
# A local checkpoint directory also works (containing rl_agent_config.json, model.safetensors, tokenizer/, encoder/).
# LAYA_MODEL=C:/models/laya-browser

# auto | cpu | cuda | cuda:0 | mps (Apple Silicon, via PyTorch) | xpu
LAYA_DEVICE=auto
# 1 loads and warms the model when the Agent is created (before the task clock). 0 loads on the first decision.
LAYA_PRELOAD=1
# Hub commit. Blank pins the default checkpoint to the commit that was measured; set it to pin another one.
# LAYA_REVISION=
# Optional token budgets. Blank uses the checkpoint's own rl_agent_config.json.
# LAYA_MAX_LEN=
# LAYA_HEAD_MAX_LEN=
# LAYA_MAX_OPTIONS=

# --- Text helper: separate small LLM that writes field values only when TYPE_TEXT is chosen. ---
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
